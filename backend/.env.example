NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# The support/admin workspace where phones appear automatically after Android login.
# End users never see or type this value.
DEVICE_REGISTRATION_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# Random secret used to sign temporary app-PIN unlock tokens. Keep server-side only.
MOBILE_UNLOCK_SECRET=replace-with-a-random-secret-at-least-32-characters
